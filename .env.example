# Core runtime
APP_ENV=development
ENFORCE_JWT_AUTH=false
DB_BACKEND=postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname
NZI_DB_PATH=carbon_business.db
NZI_DEFAULT_YEAR=2026
NZI_LOGO_URL=https://netzero.international/wp-content/uploads/2025/08/netzero-logo.png
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
API_BASE_URL=
BACKEND_API_BASE_URL=

# Auth and tenancy
NZI_JWT_SECRET=
NZI_MFA_CHALLENGE_SECRET=
MFA_ENCRYPTION_KEY=
MFA_REMEMBER_DAYS=30
REGISTRATION_TRIAL_DAYS=14
REGISTRATION_VERIFICATION_TOKEN_HOURS=72

# Email
SENDGRID_API_KEY=
FROM_EMAIL=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
STRIPE_TRIAL_DAYS=14
STRIPE_DEFAULT_PLAN=growth

# Xero
XERO_AUTH_TYPE=custom_connection
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_ORGANISATION_NAME=
XERO_REDIRECT_URI=http://localhost:8000/xero/oauth/callback
XERO_SCOPE=accounting.contacts accounting.invoices
XERO_DEFAULT_ACCOUNT_CODE=200
XERO_DEFAULT_TAX_TYPE=NONE

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_PUBLIC_MAX_REQUESTS=10
RATE_LIMIT_AUTH_MUTATION_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MUTATION_MAX_REQUESTS=30
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX_REQUESTS=240
RATE_LIMIT_READ_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX_REQUESTS=1200

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Optional AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
